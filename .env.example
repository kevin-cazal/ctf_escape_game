# Copy to .env and fill in. Every value marked "secret" must be long and random, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Where the ports listen. Keep 127.0.0.1 behind a reverse proxy on the same host.
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=9180
ROOM1_PORT=9181
ROOM2_PORT=9182

# Staff password of the dashboard.
DASHBOARD_PASSWORD=
# secret
DASHBOARD_SECRET_KEY=
# Decrypts the room answers (subjects/*/*.yaml.gpg). Given with the repository, out of band.
GPG_PASSPHRASE=
# Set to false only when the dashboard is served over plain HTTP (local test).
COOKIE_SECURE=true

# Public URL of each room (behind your HTTPS reverse proxy; http://localhost:9181... for a test
# on one machine). On its first start the dashboard registers these rooms with ROOMS_ADMIN_TOKEN;
# leave empty to add rooms by hand in Prepare. One line per room in the compose.
ROOM1_URL=https://room1.example.org
ROOM2_URL=https://room2.example.org

# CTFd admin of every room. The token is what you paste in the dashboard for each room.
ROOMS_ADMIN_PASSWORD=
# secret
ROOMS_ADMIN_TOKEN=
# secret
CTFD_SECRET_KEY=

# secret
DB_PASSWORD=
# secret
DB_ROOT_PASSWORD=
